---
import { whatsappLink } from '../config/site';

interface Props {
	message?: string;
	label?: string;
	class?: string;
}

const { message, label = 'Falar no WhatsApp', class: className } = Astro.props;
---

<a
	href={whatsappLink(message)}
	target="_blank"
	rel="noopener noreferrer"
	class:list={['btn btn-primary whatsapp-cta', className]}
>
	<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
		<path
			d="M12.01 2C6.48 2 2 6.48 2 12.01c0 1.87.5 3.63 1.44 5.16L2 22l4.97-1.4a9.96 9.96 0 0 0 5.04 1.37h.01c5.52 0 10-4.48 10-10.01C22 6.48 17.53 2 12.01 2Zm0 18.15h-.01a8.13 8.13 0 0 1-4.15-1.14l-.3-.18-3.09.87.83-3.02-.19-.31a8.13 8.13 0 0 1-1.25-4.36c0-4.5 3.66-8.16 8.17-8.16 2.18 0 4.23.85 5.78 2.4a8.1 8.1 0 0 1 2.39 5.77c0 4.5-3.67 8.13-8.18 8.13Zm4.47-6.1c-.24-.12-1.45-.71-1.68-.8-.22-.08-.39-.12-.55.12-.16.24-.63.8-.78.97-.14.16-.29.18-.53.06-.24-.12-1.02-.38-1.94-1.2a7.26 7.26 0 0 1-1.34-1.67c-.14-.24-.02-.37.11-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.55-1.32-.75-1.8-.2-.48-.4-.42-.55-.42h-.47c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.02 0 1.19.87 2.34.99 2.5.12.16 1.71 2.6 4.14 3.65.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.45-.59 1.65-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.46-.28Z"
		/>
	</svg>
	{label}
</a>

<style>
	.whatsapp-cta {
		gap: var(--space-2);
	}
</style>
