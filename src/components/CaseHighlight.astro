---
import Metrics from './Metrics.astro';
import { savolCase } from '../config/site';
---

<section class="case-highlight section-tight">
	<div class="container case-highlight__inner card">
		<div class="case-highlight__content">
			<p class="eyebrow">Case em destaque</p>
			<h2 class="text-h2">{savolCase.headline}</h2>
			<p class="text-muted">
				{savolCase.title} — {savolCase.location}. {savolCase.summary}
			</p>
			<a href={`/cases/${savolCase.slug}`} class="btn btn-secondary">Conheça o case</a>
		</div>
		<div class="case-highlight__metrics">
			<Metrics metrics={savolCase.metrics} />
			<p class="text-small text-muted">{savolCase.period}</p>
		</div>
	</div>
</section>

<style>
	.case-highlight__inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-7);
		padding: var(--space-7);
	}

	.case-highlight__content {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		align-items: flex-start;
	}

	.case-highlight__metrics {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding-top: var(--space-6);
		border-top: 1px solid var(--color-border);
	}

	@media (min-width: 960px) {
		.case-highlight__inner {
			flex-direction: row;
			align-items: center;
			padding: var(--space-8);
		}

		.case-highlight__content {
			flex: 1.1;
		}

		.case-highlight__metrics {
			flex: 1;
			padding-top: 0;
			border-top: none;
			padding-left: var(--space-8);
			border-left: 1px solid var(--color-border);
		}
	}
</style>
