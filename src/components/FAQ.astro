---
interface Item {
	question: string;
	answer: string;
}

interface Props {
	items: Item[];
	title?: string;
}

const { items, title = 'Perguntas frequentes' } = Astro.props;

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: items.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.answer,
		},
	})),
};
---

<section class="faq section-tight">
	<div class="container faq__inner">
		<h2 class="text-h2">{title}</h2>
		<div class="faq__list">
			{
				items.map((item) => (
					<details class="faq__item">
						<summary>{item.question}</summary>
						<p class="text-muted">{item.answer}</p>
					</details>
				))
			}
		</div>
	</div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
	.faq__inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		max-width: 820px;
	}

	.faq__list {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.faq__item {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: var(--space-4) var(--space-5);
	}

	.faq__item summary {
		cursor: pointer;
		font-weight: 600;
		list-style: none;
	}

	.faq__item summary::-webkit-details-marker {
		display: none;
	}

	.faq__item summary::after {
		content: '+';
		float: right;
		color: var(--color-accent);
		font-size: 1.25rem;
	}

	.faq__item[open] summary::after {
		content: '−';
	}

	.faq__item p {
		margin-top: var(--space-3);
	}
</style>
