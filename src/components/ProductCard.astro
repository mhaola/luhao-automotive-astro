---
import type { Product } from '../config/site';

interface Props {
	product: Product;
}

const { product } = Astro.props;
---

<a href={`/produtos/${product.slug}`} class="product-card card">
	<span class="product-card__label">{product.shortLabel}</span>
	<h3 class="text-h3">{product.tagline}</h3>
	<p class="text-muted">{product.cardDescription}</p>
	<span class="product-card__link">Conhecer o {product.shortLabel} →</span>
</a>

<style>
	.product-card {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		padding: var(--space-6);
		text-decoration: none;
		color: var(--color-text);
		height: 100%;
		transition: border-color 0.15s ease, transform 0.15s ease;
	}

	.product-card:hover {
		border-color: var(--color-accent);
	}

	.product-card__label {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent);
	}

	.product-card__link {
		margin-top: auto;
		padding-top: var(--space-3);
		font-weight: 600;
		font-size: 0.9375rem;
	}
</style>
