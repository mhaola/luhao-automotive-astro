---
import type { TaxonomyGroup } from '../lib/insights';

interface Props {
	categories: TaxonomyGroup[];
	/** Slug da categoria ativa, se a página atual for uma página de categoria. */
	activeSlug?: string;
}

const { categories, activeSlug } = Astro.props;
---

<nav class="insight-filters" aria-label="Filtrar Insights por categoria" data-insight-filters>
	<a href="/insights" class:list={['pill', { 'pill--active': !activeSlug }]}>Todos</a>
	{
		categories.map((category) => (
			<a
				href={`/insights/categoria/${category.slug}`}
				class:list={['pill', { 'pill--active': activeSlug === category.slug }]}
			>
				{category.name} <span class="pill__count">{category.posts.length}</span>
			</a>
		))
	}
</nav>

<style>
	.insight-filters {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-bottom: var(--space-5);
	}
</style>
