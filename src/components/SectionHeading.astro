---
interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
	align?: 'left' | 'center';
	as?: 'h1' | 'h2' | 'h3';
}

const { eyebrow, title, description, align = 'left', as: Heading = 'h2' } = Astro.props;
---

<div class:list={['section-heading', { 'section-heading--center': align === 'center' }]}>
	{eyebrow && <p class="eyebrow">{eyebrow}</p>}
	<Heading class="text-h2">{title}</Heading>
	{description && <p class="section-heading__description text-muted">{description}</p>}
</div>

<style>
	.section-heading {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		max-width: 640px;
		margin-bottom: var(--space-7);
	}

	.section-heading--center {
		max-width: 720px;
		margin-inline: auto;
		text-align: center;
	}

	.section-heading__description {
		font-size: 1.0625rem;
		line-height: var(--line-height-normal);
	}
</style>
