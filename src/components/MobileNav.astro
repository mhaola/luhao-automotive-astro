---
import { mainNav, primaryCta, productList } from '../config/site';
---

<div class="mobile-nav" id="mobile-nav" hidden>
	<nav aria-label="Navegação mobile">
		<ul>
			<li>
				<span class="mobile-nav__label">Produtos</span>
				<ul class="mobile-nav__sublist">
					{
						productList.map((product) => (
							<li>
								<a href={`/produtos/${product.slug}`}>{product.shortLabel}</a>
							</li>
						))
					}
					<li>
						<a href="/produtos">Ver todos os produtos</a>
					</li>
				</ul>
			</li>
			{
				mainNav.slice(1).map((item) => (
					<li>
						<a href={item.href}>{item.label}</a>
					</li>
				))
			}
			<li>
				<a href={primaryCta.href} class="btn btn-primary mobile-nav__cta">{primaryCta.label}</a>
			</li>
		</ul>
	</nav>
</div>

<style>
	.mobile-nav {
		border-bottom: 1px solid var(--color-border);
		background: var(--color-bg);
	}

	.mobile-nav[hidden] {
		display: none;
	}

	.mobile-nav .container,
	.mobile-nav nav {
		padding: 0;
	}

	.mobile-nav ul {
		display: flex;
		flex-direction: column;
	}

	.mobile-nav > nav > ul {
		padding: var(--space-4) var(--container-padding) var(--space-6);
		gap: var(--space-2);
	}

	.mobile-nav__label {
		display: block;
		padding: var(--space-3) 0 var(--space-2);
		font-size: 0.8125rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-text-muted);
	}

	.mobile-nav__sublist {
		gap: 0;
		border-left: 2px solid var(--color-border);
		margin-bottom: var(--space-3);
	}

	.mobile-nav a {
		display: block;
		padding: var(--space-3) var(--space-4);
		text-decoration: none;
		color: var(--color-text);
		font-weight: 500;
		border-radius: var(--radius-sm);
	}

	.mobile-nav > nav > ul > li > a:hover,
	.mobile-nav__sublist a:hover {
		background: var(--color-surface);
	}

	.mobile-nav__cta {
		margin-top: var(--space-3);
		width: 100%;
	}

	@media (min-width: 960px) {
		.mobile-nav {
			display: none;
		}
	}
</style>

<script>
	const toggle = document.getElementById('mobile-menu-toggle');
	const nav = document.getElementById('mobile-nav');

	if (toggle && nav) {
		toggle.addEventListener('click', () => {
			const isOpen = toggle.getAttribute('aria-expanded') === 'true';
			toggle.setAttribute('aria-expanded', String(!isOpen));
			nav.hidden = isOpen;
		});
	}
</script>
