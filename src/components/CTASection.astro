---
import WhatsAppCTA from './WhatsAppCTA.astro';

interface Props {
	title: string;
	description?: string;
	whatsappMessage?: string;
	secondaryHref?: string;
	secondaryLabel?: string;
}

const {
	title,
	description,
	whatsappMessage,
	secondaryHref = '/contato',
	secondaryLabel = 'Falar com a LuHao',
} = Astro.props;
---

<section class="cta-section section-tight">
	<div class="container cta-section__inner card">
		<div class="cta-section__text">
			<h2 class="text-h2">{title}</h2>
			{description && <p class="text-muted">{description}</p>}
		</div>
		<div class="cta-section__actions">
			<WhatsAppCTA message={whatsappMessage} />
			<a href={secondaryHref} class="btn btn-secondary">{secondaryLabel}</a>
		</div>
	</div>
</section>

<style>
	.cta-section__inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
		padding: var(--space-7);
		background: var(--color-surface-raised);
	}

	.cta-section__text {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.cta-section__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
	}

	@media (min-width: 860px) {
		.cta-section__inner {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
		}
	}
</style>
