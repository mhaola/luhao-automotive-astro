---
import { productList } from '../config/site';
import ProductCard from './ProductCard.astro';
---

<div class="product-grid">
	{productList.map((product) => <ProductCard product={product} featured={product.slug === 'drive'} />)}
</div>

<style>
	.product-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.1rem;
	}

	@media (min-width: 720px) {
		.product-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1080px) {
		.product-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			grid-auto-rows: minmax(228px, auto);
		}

		.product-grid :global(.product-card--featured) {
			grid-column: span 2;
			grid-row: span 2;
		}
	}
</style>
