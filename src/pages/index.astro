---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProductGrid from '../components/ProductGrid.astro';
import CaseHighlight from '../components/CaseHighlight.astro';
import CTASection from '../components/CTASection.astro';
import { site } from '../config/site';

const journeys = [
	{ name: 'Assinatura', detail: 'Intenção de uso, não de posse. Ciclo de decisão mais curto, PF e PJ.' },
	{ name: '0 km', detail: 'Modelo, oferta e estoque guiando a demanda até o test-drive e a venda.' },
	{ name: 'Seminovos', detail: 'Veículo específico, preço e condição — decisão orientada por disponibilidade.' },
	{ name: 'Pós-venda', detail: 'Capacidade de oficina e recorrência, não uma venda única.' },
];
---

<BaseLayout title={site.name} description={site.description} path="/">
	<section class="hero">
		<picture class="hero__bg" aria-hidden="true">
			<source media="(max-width: 767px)" srcset="/images/hero-mobile.avif" type="image/avif" />
			<source media="(max-width: 767px)" srcset="/images/hero-main-mobile.webp" type="image/webp" />
			<source media="(min-width: 768px)" srcset="/images/hero-desktop.avif" type="image/avif" />
			<source media="(min-width: 768px)" srcset="/images/hero-main-desktop.webp" type="image/webp" />
			<img src="/images/hero-main-desktop.webp" alt="" width="2000" height="1116" loading="eager" />
		</picture>
		<div class="hero__overlay" aria-hidden="true"></div>
		<div class="container hero__inner">
			<div class="hero__text">
				<h1 class="text-display">{site.tagline}</h1>
				<p class="hero__subheadline text-muted">{site.description}</p>
				<div class="hero__actions">
					<a href="/produtos" class="btn btn-primary">Conheça nossas soluções</a>
					<a href="/contato" class="btn btn-secondary">Fale com a LuHao</a>
				</div>
			</div>
		</div>
	</section>

	<section class="section-tight journeys">
		<div class="container">
			<SectionHeading
				eyebrow="Como pensamos"
				title="Automotivo não é um único funil."
				description="A intenção, o argumento comercial, o momento de compra e os critérios de qualificação mudam de acordo com o produto. A LuHao Automotive estrutura cada operação de acordo com a jornada que precisa gerar."
			/>
			<div class="journeys__grid">
				{
					journeys.map((journey) => (
						<div class="journeys__item card">
							<h3 class="text-h3">{journey.name}</h3>
							<p class="text-muted">{journey.detail}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="section-tight">
		<div class="container">
			<SectionHeading
				eyebrow="Nossos produtos"
				title="Cinco produtos, cinco jornadas comerciais."
				description="Cada produto da LuHao Automotive resolve uma etapa específica da operação — da geração de demanda à inteligência sobre o resultado."
			/>
			<ProductGrid />
		</div>
	</section>

	<CaseHighlight />

	<CTASection
		title="Pronto para estruturar a geração de demanda da sua operação?"
		description="Conte pra gente sobre seu negócio — assinatura, vendas ou pós-venda — e vamos entender qual produto faz sentido."
		whatsappMessage="Olá! Quero conhecer as soluções da LuHao Automotive."
	/>
</BaseLayout>

<style>
	.hero {
		position: relative;
		min-height: 640px;
		display: flex;
		align-items: center;
		overflow: hidden;
	}

	.hero__bg {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero__bg img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero__overlay {
		position: absolute;
		inset: 0;
		z-index: 1;
		background:
			linear-gradient(90deg, var(--color-bg) 12%, rgba(2, 11, 36, 0.78) 45%, rgba(2, 11, 36, 0.35) 100%),
			linear-gradient(0deg, var(--color-bg) 0%, transparent 30%);
	}

	.hero__inner {
		position: relative;
		z-index: 2;
		padding-block: var(--space-9);
	}

	.hero__text {
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
		max-width: 640px;
	}

	.hero__subheadline {
		font-size: 1.125rem;
		max-width: 560px;
		color: rgba(255, 255, 255, 0.82);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-2);
	}

	@media (max-width: 767px) {
		.hero {
			min-height: 560px;
		}

		.hero__overlay {
			background:
				linear-gradient(180deg, rgba(2, 11, 36, 0.55) 0%, var(--color-bg) 92%);
		}
	}

	.journeys__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
	}

	.journeys__item {
		padding: var(--space-5);
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	@media (min-width: 640px) {
		.journeys__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1100px) {
		.journeys__grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>
