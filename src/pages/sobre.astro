---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTASection from '../components/CTASection.astro';

const title = 'Sobre a LuHao Automotive';
const description =
	'A LuHao Automotive é a operação especializada em marketing para o setor automotivo da LuHao, conectando marketing, demanda, automação, qualificação e inteligência comercial.';

const pilares = [
	{ title: 'Marketing', text: 'Geração de demanda estruturada para cada jornada comercial do setor automotivo.' },
	{ title: 'Demanda', text: 'Campanhas orientadas ao que a operação realmente precisa vender ou atender.' },
	{ title: 'Automação', text: 'Atendimento inicial automatizado para reduzir tempo de resposta e contexto perdido.' },
	{ title: 'Qualificação', text: 'Filtragem de leads antes da chegada ao time comercial, com contexto relevante.' },
	{ title: 'Inteligência comercial', text: 'Visibilidade sobre a jornada entre investimento, leads e resultado.' },
];
---

<BaseLayout title={title} description={description} path="/sobre">
	<section class="section-tight">
		<div class="container about-hero">
			<Breadcrumbs items={[{ label: 'Sobre', href: '/sobre' }]} />
			<p class="eyebrow">Quem somos</p>
			<h1 class="text-h1">A LuHao Automotive é a operação da LuHao especializada em marketing para o setor automotivo.</h1>
			<p class="text-muted about-hero__lead">{description}</p>
		</div>
	</section>

	<section class="section-tight">
		<div class="container">
			<SectionHeading
				eyebrow="Como trabalhamos"
				title="Cinco frentes que sustentam a operação."
				description="A especialização da LuHao Automotive busca conectar essas cinco frentes em uma única operação de marketing e vendas."
			/>
			<div class="pillar-grid">
				{
					pilares.map((item) => (
						<div class="card pillar-grid__item">
							<h3 class="text-h3">{item.title}</h3>
							<p class="text-muted">{item.text}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="section-tight">
		<div class="container">
			<SectionHeading eyebrow="Especialização" title="Foco no ecossistema automotivo." />
			<p class="text-muted about-text">
				A LuHao Automotive nasceu da constatação de que operações automotivas — concessionárias, grupos, programas
				de assinatura e redes de pós-venda — têm jornadas comerciais distintas demais para serem tratadas com
				marketing genérico. A experiência da equipe no setor automotivo orienta a forma como estruturamos cada
				produto: sempre a partir do funil e do momento de decisão de quem está do outro lado.
			</p>
		</div>
	</section>

	<CTASection title="Quer conhecer a operação da LuHao Automotive de perto?" whatsappMessage="Olá! Quero saber mais sobre a LuHao Automotive." />
</BaseLayout>

<style>
	.about-hero {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		max-width: 780px;
	}

	.about-hero__lead {
		font-size: 1.0625rem;
	}

	.pillar-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
	}

	.pillar-grid__item {
		padding: var(--space-5);
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.about-text {
		max-width: 760px;
		font-size: 1.0625rem;
	}

	@media (min-width: 640px) {
		.pillar-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1000px) {
		.pillar-grid {
			grid-template-columns: repeat(5, 1fr);
		}
	}
</style>
