---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const title = 'Insights';
const description = 'Conteúdo prático sobre geração de demanda, qualificação e inteligência para operações automotivas.';

const allInsights = await getCollection('insights', ({ data }) => !data.draft);
const posts = allInsights.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const dateFormatter = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
---

<BaseLayout title={title} description={description} path="/insights">
	<section class="section-tight">
		<div class="container">
			<Breadcrumbs items={[{ label: 'Insights', href: '/insights' }]} />
			<SectionHeading eyebrow="Conteúdo" title="Insights sobre marketing automotivo." description={description} />

			<div class="insight-grid">
				{
					posts.map((post) => (
						<a href={`/insights/${post.id}`} class="insight-card card">
							<p class="eyebrow">{post.data.category}</p>
							<h2 class="text-h3">{post.data.title}</h2>
							<p class="text-muted">{post.data.description}</p>
							<p class="text-small text-muted insight-card__date">
								{dateFormatter.format(post.data.pubDate)}
							</p>
						</a>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.insight-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-5);
	}

	.insight-card {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		padding: var(--space-6);
		text-decoration: none;
		color: var(--color-text);
	}

	.insight-card:hover {
		border-color: var(--color-accent);
	}

	.insight-card__date {
		margin-top: auto;
		padding-top: var(--space-2);
	}

	@media (min-width: 700px) {
		.insight-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1000px) {
		.insight-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
